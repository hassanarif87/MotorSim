load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "simulation_executor",
    hdrs = ["simulation_executor.h"],
    visibility = [
        "//blocks:__pkg__",
        "//test:__pkg__",
    ],
)

cc_library(
    name = "rk4",
    hdrs = ["rk4.h"],
    visibility = [
        "//blocks:__pkg__",
        "//test:__pkg__",
    ],
)

cc_library(
    name = "configuration",
    hdrs = ["configuration.h"],
    visibility = [
        "//blocks:__pkg__",
        "//drive:__pkg__",
    ],
    deps = [
        ":simulation_executor",
        "//graph:connections",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "csv_logger",
    srcs = ["csv_logger.cpp"],
    hdrs = ["csv_logger.h"],
    deps = [
        ":simulation_executor",
        "//drive",
        "@csv-parser//:csv-parser",
    ],
)

cc_binary(
    name = "pmsm_sim",
    srcs = ["main.cpp"],
    data = ["pmsm_config.json"],
    deps = [
        ":configuration",
        ":csv_logger",
        ":simulation_executor",
        "//drive",
    ],
)
