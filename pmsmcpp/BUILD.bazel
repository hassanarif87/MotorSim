load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "simulation_executor",
    hdrs = ["simulation_executor.h"],
    visibility = ["//blocks:__pkg__"],
)

cc_library(
    name = "connections",
    hdrs = ["connections.h"],
)

cc_library(
    name = "block_graph",
    hdrs = ["block_graph.h"],
    visibility = ["//blocks:__pkg__"],
    deps = [
        ":connections",
        "@boost.describe",
        "@boost.mp11",
    ],
)

cc_library(
    name = "drive",
    hdrs = ["drive.h"],
    deps = ["//blocks:drive_blocks"],
)

cc_library(
    name = "rk4",
    hdrs = ["rk4.h"],
    visibility = ["//blocks:__pkg__"],
)

cc_library(
    name = "configuration",
    hdrs = ["configuration.h"],
    visibility = ["//blocks:__pkg__"],
    deps = [
        ":connections",
        ":simulation_executor",
        "//blocks:plant",
        "@nlohmann_json//:json",
    ],
)

cc_binary(
    name = "pmsm_sim",
    srcs = ["main.cpp"],
    data = ["pmsm_config.json"],
    deps = [
        ":configuration",
        ":drive",
        ":simulation_executor",
        "@csv-parser//:csv-parser",
    ],
)

cc_test(
    name = "blocks_test",
    srcs = ["blocks_test.cpp"],
    deps = [
        "//blocks:current_pi",
        "//blocks:inverter",
        "//blocks:plant",
        "//blocks:svpwm",
    ],
)

cc_test(
    name = "simulation_executor_test",
    size = "small",
    srcs = ["simulation_executor_test.cpp"],
    deps = [
        ":rk4",
        ":simulation_executor",
    ],
)

cc_test(
    name = "block_graph_test",
    size = "small",
    srcs = ["block_graph_test.cpp"],
    deps = [":block_graph"],
)
