load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "signals",
    hdrs = ["signals.h"],
    deps = ["@eigen//:eigen"],
)

cc_library(
    name = "transforms",
    hdrs = ["transforms.h"],
    deps = [":signals"],
)

cc_library(
    name = "plant",
    hdrs = ["plant.h"],
    deps = [":transforms"],
)

cc_library(
    name = "continuous_pmsm",
    hdrs = ["continuous_pmsm.h"],
    deps = [
        ":plant",
        "//:rk4",
        "//:simulation_executor",
    ],
)

cc_library(
    name = "current_feedback",
    hdrs = ["current_feedback.h"],
    deps = [":transforms"],
)

cc_library(
    name = "current_pi",
    hdrs = ["current_pi.h"],
    deps = [":signals"],
)

cc_library(
    name = "svpwm",
    hdrs = ["svpwm.h"],
    deps = [":transforms"],
)

cc_library(
    name = "inverter",
    hdrs = ["inverter.h"],
    deps = [":signals"],
)

cc_library(
    name = "speed_control",
    hdrs = ["speed_control.h"],
)

cc_library(
    name = "drive_blocks",
    hdrs = ["drive_blocks.h"],
    deps = [
        ":continuous_pmsm",
        ":current_feedback",
        ":current_pi",
        ":inverter",
        ":speed_control",
        ":svpwm",
        "//:block_graph",
        "//:configuration",
    ],
)
